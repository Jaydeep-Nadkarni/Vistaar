# Copy this file to .env.local and fill in the values.

# Google Apps Script Web App URL (see GOOGLE_SHEETS_SETUP.md)
VITE_SHEETS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# UPI account that receives registration fees
VITE_UPI_ID=yourname@okbank
VITE_UPI_PAYEE_NAME=Your Name

# Fee per person, in rupees
VITE_FEE_IEEE=100
VITE_FEE_NON_IEEE=150

# WhatsApp group invite links, shown after registration and included in the confirmation email
VITE_WHATSAPP_CTF=https://chat.whatsapp.com/XXXXXXXX
VITE_WHATSAPP_CYBER_HEIST=https://chat.whatsapp.com/XXXXXXXX
VITE_WHATSAPP_SESSIONS=https://chat.whatsapp.com/XXXXXXXX
